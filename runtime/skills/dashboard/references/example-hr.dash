<board name="人力仪表板 · 研发中心" gap="12">
  <style>
    .k-s{display:flex;flex-direction:column;gap:4px}
    .k-s .n{font-size:28px;font-weight:700}
    .k-s .d{font-size:12px;color:var(--mx-text-secondary)}
  </style>
  <card id="h-total" span="6" title="团队人数">
    <div class="k-s"><span class="n">36</span><span class="d">5 个部门</span></div>
  </card>
  <card id="h-in" span="6" title="本月入职">
    <style>.k-s .n{color:var(--mx-success)}</style>
    <div class="k-s"><span class="n">3</span><span class="d">较上月 +1</span></div>
  </card>
  <card id="h-out" span="6" title="本月离职">
    <style>.k-s .n{color:var(--mx-danger)}</style>
    <div class="k-s"><span class="n">1</span><span class="d">主动离职</span></div>
  </card>
  <card id="h-hire" span="6" title="在招岗位">
    <style>.k-s .n{color:var(--mx-accent)}</style>
    <div class="k-s"><span class="n">5</span><span class="d">2 个岗位急招</span></div>
  </card>

  <card id="dept" span="12" title="部门人数分布">
    <style>
      .row{display:flex;align-items:center;gap:10px;margin-bottom:9px;font-size:13px}
      .row .name{width:72px;flex-shrink:0;opacity:.75}
      .row .track{flex:1;height:10px;border-radius:5px;background:color-mix(in currentColor,10%,transparent)}
      .row .track i{display:block;height:100%;border-radius:5px;background:var(--mx-accent)}
      .row .v{width:28px;text-align:right;font-weight:600;flex-shrink:0}
    </style>
    <div class="row"><span class="name">客户端</span><span class="track"><i style="width:83%"></i></span><span class="v">10</span></div>
    <div class="row"><span class="name">服务端</span><span class="track"><i style="width:75%"></i></span><span class="v">9</span></div>
    <div class="row"><span class="name">算法</span><span class="track"><i style="width:58%"></i></span><span class="v">7</span></div>
    <div class="row"><span class="name">产品</span><span class="track"><i style="width:42%"></i></span><span class="v">5</span></div>
    <div class="row"><span class="name">测试</span><span class="track"><i style="width:42%"></i></span><span class="v">5</span></div>
  </card>

  <card id="funnel" span="12" title="本月招聘漏斗">
    <style>
      .f{display:flex;flex-direction:column;gap:6px;font-size:13px}
      .step{display:flex;align-items:center;gap:10px}
      .step .label{width:64px;flex-shrink:0;color:var(--mx-text-secondary);font-size:12px}
      .step .bar{height:22px;border-radius:6px;background:var(--mx-accent);min-width:36px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;color:var(--mx-text-on-accent);font-size:12px;font-weight:600}
    </style>
    <div class="f">
      <div class="step"><span class="label">简历</span><span class="bar" style="width:100%">128</span></div>
      <div class="step"><span class="label">初筛通过</span><span class="bar" style="width:52%">67</span></div>
      <div class="step"><span class="label">面试</span><span class="bar" style="width:30%">38</span></div>
      <div class="step"><span class="label">Offer</span><span class="bar" style="width:14%">9</span></div>
      <div class="step"><span class="label">入职</span><span class="bar" style="width:8%;background:var(--mx-success)">6</span></div>
    </div>
  </card>

  <card id="members" span="24" title="团队成员">
    <style>
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
      .m{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;background:color-mix(in currentColor,5%,transparent)}
      .ava{flex-shrink:0;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:var(--mx-text-on-accent)}
      .m .who{min-width:0}
      .m .who b{display:block;font-size:13px;font-weight:600}
      .m .who span{display:block;font-size:11px;color:var(--mx-text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .st{flex-shrink:0;margin-left:auto;width:7px;height:7px;border-radius:50%}
      .on{background:var(--mx-success)}.busy{background:var(--mx-warning)}.off{background:color-mix(in currentColor,30%,transparent)}
      .c1{background:var(--mx-accent)}.c2{background:var(--mx-success)}.c3{background:var(--mx-warning)}.c4{background:var(--mx-business)}
    </style>
    <div class="grid">
      <div class="m"><span class="ava c1">陈</span><span class="who"><b>陈晓</b><span>客户端 · T3</span></span><span class="st on"></span></div>
      <div class="m"><span class="ava c2">李</span><span class="who"><b>李响</b><span>服务端 · T4</span></span><span class="st busy"></span></div>
      <div class="m"><span class="ava c3">王</span><span class="who"><b>王一</b><span>测试 · T3</span></span><span class="st on"></span></div>
      <div class="m"><span class="ava c4">周</span><span class="who"><b>周舟</b><span>产品 · T4</span></span><span class="st off"></span></div>
    </div>
  </card>
</board>
